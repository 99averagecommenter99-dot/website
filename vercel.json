{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/tutor.js": {
      "maxDuration": 30
    },
    "api/tutor/status.js": {
      "includeFiles": "{index.html,resources/**}"
    }
  },
  "headers": [
    {
      "source": "/resources/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
