# Copy this file to .env and add your Gemini API key from Google AI Studio.
# Never commit .env or expose this key in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Leave APP_ORIGIN unset for local development on http://localhost:4174 / http://127.0.0.1:4174.
# Set APP_ORIGIN to your exact HTTPS site origin only when configuring a secured deployment.
